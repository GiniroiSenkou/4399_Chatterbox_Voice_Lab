# Chatterbox Voice Lab Pro - Environment Configuration

# Server
PORT=8080
BACKEND_PORT=8000

# Device: cpu, cuda, mps
DEVICE=cpu

# Model configuration
DEFAULT_MODEL=turbo
MAX_LOADED_MODELS=1

# Paths (inside container)
STORAGE_ROOT=/app/data
DATABASE_URL=sqlite+aiosqlite:////app/data/db/voicelab.db
HF_HOME=/app/data/models

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_VOICE_DURATION_S=60
MIN_VOICE_DURATION_S=5

# CORS (for development)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
